# Copie para .env e ajuste. O .env está no .gitignore: nunca faça commit dele.
# Nenhuma senha vai aqui: a senha do Zabbix é digitada na tela e fica só na memória do servidor.

# URL sugerida no formulário (API JSON-RPC do Zabbix)
SLA_ZABBIX_DEFAULT_URL=https://zabbix.exemplo.com.br/api_jsonrpc.php

# Servidores Zabbix que a aplicação pode chamar (separe por vírgula; aceita *.dominio).
# Recomendado preencher: impede que a app seja usada para sondar outros servidores (SSRF).
SLA_ZABBIX_ALLOWED_HOSTS=zabbix.exemplo.com.br

# 1 = permite http:// para o Zabbix (a senha trafega sem criptografia). Evite.
SLA_ALLOW_INSECURE_ZABBIX=0

# Servidores liberados para http:// (separe por vírgula). Os demais continuam exigindo HTTPS.
# Deixe vazio, a não ser que use um Zabbix local sem TLS (ex.: "zabbix-frontend" na rede Docker).
SLA_INSECURE_ZABBIX_HOSTS=

# Nomes pelos quais a interface é acessada (cabeçalho Host). Protege contra DNS rebinding.
SLA_ALLOWED_HOSTS=localhost,127.0.0.1

# 1 = cookie de sessão só por HTTPS (use quando houver proxy TLS na frente)
SLA_COOKIE_SECURE=0

# Sessão (a senha do Zabbix fica na memória do servidor só enquanto a sessão existir)
SLA_SESSION_IDLE_MINUTES=120
SLA_SESSION_MAX_HOURS=12

# Proteções de uso
SLA_MAX_CONCURRENT_REPORTS=2
SLA_LOGIN_MAX_FAILURES=5
SLA_LOGIN_FAILURE_WINDOW_MINUTES=10
SLA_LOGIN_BLOCK_MINUTES=15
